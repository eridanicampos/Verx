{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Transactions": ""
  },
  "Auth": {
    "Authority": "http://localhost:5003",
    "Issuer": "cashflow-identity",
    "Audience": "cashflow-api",
    "RequireHttpsMetadata": true
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "cashflow",
    "Exchange": "cashflow.transactions"
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 100,
    "PollingInterval": "00:00:00.500",
    "MaxAttempts": 20
  },
  "Pii": {
    "ActiveKeyId": "k1"
  },
  "RateLimiting": {
    "WritesPerSecondPerClient": 100
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
