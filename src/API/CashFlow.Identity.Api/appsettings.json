{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Identity": ""
  },
  "Jwt": {
    "Issuer": "cashflow-identity",
    "Audience": "cashflow-api",
    "PublicBaseUrl": "http://localhost:5003",
    "AccessTokenLifetime": "00:10:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "AllowEphemeralKey": false
  },
  "Identity": {
    "SeedUsers": [
      { "Username": "operador", "Role": "operator" },
      { "Username": "analista", "Role": "analyst" }
    ]
  },
  "RateLimiting": {
    "LoginPerMinutePerIp": 10
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  }
}
