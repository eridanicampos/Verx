{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:8080" ]
  },
  "RateLimiting": {
    "RequestsPerSecondPerIp": 100,
    "BurstPerIp": 200,
    "AuthRequestsPerMinutePerIp": 20
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "well-known": {
        "ClusterId": "identity",
        "Match": { "Path": "/.well-known/{**catch-all}" }
      },
      "balances": {
        "ClusterId": "consolidation",
        "Order": 1,
        "Match": { "Path": "/api/v1/accounts/{accountId}/balance" }
      },
      "daily-balances": {
        "ClusterId": "consolidation",
        "Order": 1,
        "Match": { "Path": "/api/v1/accounts/{accountId}/daily-balances" }
      },
      "transactions": {
        "ClusterId": "transactions",
        "Order": 10,
        "Match": { "Path": "/api/v1/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "http://localhost:5003" } }
      },
      "transactions": {
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "HealthCheck": {
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Destinations": { "d1": { "Address": "http://localhost:5001" } }
      },
      "consolidation": {
        "HttpRequest": { "ActivityTimeout": "00:00:10" },
        "HealthCheck": {
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Destinations": { "d1": { "Address": "http://localhost:5002" } }
      }
    }
  }
}
