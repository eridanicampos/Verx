{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Consolidation": ""
  },
  "Auth": {
    "Authority": "http://localhost:5003",
    "Issuer": "cashflow-identity",
    "Audience": "cashflow-api",
    "RequireHttpsMetadata": true
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "cashflow",
    "SourceExchange": "cashflow.transactions",
    "Queue": "consolidation.transactions",
    "PrefetchCount": 32,
    "MaxRetries": 5,
    "RetryDelay": "00:00:05"
  },
  "RateLimiting": {
    "ReadsPerSecondPerClient": 200
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
